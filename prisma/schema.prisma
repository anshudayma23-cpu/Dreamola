generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  free
  mid
  premium
}

enum ReportStatus {
  pending
  reviewed
  dismissed
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  passwordHash            String
  username                String    @unique
  displayName             String?
  bio                     String?
  plan                    Plan      @default(free)
  isAdmin                 Boolean   @default(false)
  role                    String    @default("user")
  interpretationsUsedToday Int      @default(0)
  literalArtUsedToday     Int      @default(0)
  feelingArtUsedToday     Int      @default(0)
  limitsResetAt           DateTime  @default(now())
  razorpaySubscriptionId  String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  dreams                  Dream[]
  comments                Comment[]
  likes                   Like[]
  reports                 Report[]
  followers               Follow[]  @relation("following")
  following               Follow[]  @relation("follower")
}

model Dream {
  id              String    @id @default(uuid())
  userId          String
  dreamText       String
  interpretation  String?
  artUrl          String?
  moodTags        String[]
  customTags      String[]
  isPublic        Boolean   @default(false)
  likeCount       Int       @default(0)
  commentCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbols         DreamSymbol[]
  comments        Comment[]
  likes           Like[]
  reports         Report[]  @relation("dreamReports")
}

model Symbol {
  id                  Int      @id @default(autoincrement())
  keyword             String   @unique
  aliases             String[]
  interpretationTheme String
  category            String?

  dreams              DreamSymbol[]
}

model DreamSymbol {
  dreamId   String
  symbolId  Int

  dream     Dream   @relation(fields: [dreamId], references: [id], onDelete: Cascade)
  symbol    Symbol  @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@id([dreamId, symbolId])
}

model Comment {
  id        String    @id @default(uuid())
  dreamId   String
  userId    String
  parentId  String?
  body      String
  createdAt DateTime  @default(now())

  dream     Dream     @relation(fields: [dreamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("replies")
}

model Like {
  dreamId   String
  userId    String
  createdAt DateTime @default(now())

  dream     Dream @relation(fields: [dreamId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([dreamId, userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  dreamId    String?
  commentId  String?
  reason     String
  status     ReportStatus @default(pending)
  createdAt  DateTime     @default(now())

  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  dream      Dream? @relation("dreamReports", fields: [dreamId], references: [id], onDelete: SetNull)
}
